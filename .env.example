# 环境变量示例文件
# 复制此文件为 .env 并填入你的配置信息

# ==================== LLM / Embedding 配置 ====================
# 模型模式: dashscope 或 ollama
LLM_MODE=ollama

# 阿里云 DashScope API Key (使用云端模型时必需)
# 获取地址: https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=your-dashscope-api-key

# Ollama 配置 (使用本地模型时)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# ==================== Milvus 向量数据库配置 ====================
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_USERNAME=root
MILVUS_PASSWORD=Milvus

# ==================== 飞书机器人配置 ====================
# 注意：变量名与 application.yml 保持一致
FEI_SHU_APP_ID=your-feishu-app-id
FEI_SHU_APP_SECRET=your-feishu-app-secret

# ==================== 钉钉机器人配置 ====================
DINGTALK_APP_KEY=your-dingtalk-app-key
DINGTALK_APP_SECRET=your-dingtalk-app-secret

# ==================== 管理后台登录配置 ====================
# 管理后台登录配置
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin@2026
